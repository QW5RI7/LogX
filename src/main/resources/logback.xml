<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 1. 变量：日志目录和格式 -->
    <property name="LOG_DIR" value="${user.home}/.logx/logs" />
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n" />

    <!-- 2. 控制台输出（开发时用，IDE 里能看到） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 3. 文件输出：按时间 + 大小滚动 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前正在写入的日志文件 -->
        <file>${LOG_DIR}/launcher.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 滚动后的文件名：launcher.2026-11-07.0.log、launcher.2026-11-07.1.log ... -->
            <fileNamePattern>${LOG_DIR}/launcher.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 单个文件最大 10MB，超过就切新文件 -->
            <maxFileSize>10MB</maxFileSize>
            <!-- 保留 15 天历史日志 -->
            <maxHistory>15</maxHistory>
            <!-- 所有日志文件总大小不超过 500MB，防止把用户磁盘塞满 -->
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 4. 根日志级别 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>